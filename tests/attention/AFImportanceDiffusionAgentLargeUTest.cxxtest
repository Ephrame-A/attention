/*
 * tests/attention/AFImportanceDiffusionAgentLargeUTest.cxxtest
 *
 * Test for AFImportanceDiffusionAgent with a larger number of nodes.
 */

#include <cxxtest/TestSuite.h>
#include <opencog/attentionbank/bank/AttentionBank.h>
#include <opencog/attention/AFImportanceDiffusionAgent.h>
#include <opencog/atomspace/AtomSpace.h>
#include <opencog/cogserver/server/CogServer.h>
#include <opencog/util/Logger.h>
#include <opencog/util/Config.h>
#include <opencog/cogserver/modules/agents/AgentsModule.h>
#include <opencog/attentionbank/types/atom_types.h>
#include <opencog/attention/AttentionParamQuery.h>
#include <iostream>
#include <vector>
#include <string>
#include <fstream>
#include <chrono>

using namespace opencog;

class AFImportanceDiffusionAgentLargeUTest : public CxxTest::TestSuite
{
private:
    AtomSpace* as;
    CogServer* cogServer;
    Scheduler* scheduler;
    AFImportanceDiffusionAgent* afImportanceDiffusionAgent;
    AttentionParamQuery* atq;

public:
    void setUp()
    {
        cogServer = &cogserver();
        config().set("MODULES", "opencog/attention/libattention.so");
        cogServer->loadModules();
        config().set("MODULES", "libagents.so");

        Module* amod = cogServer->getModule("opencog::AgentsModule");
        AgentsModule* agmod = static_cast<AgentsModule*>(amod);
        scheduler = &agmod->get_scheduler();

        as = &cogserver().getAtomSpace();
        afImportanceDiffusionAgent = new AFImportanceDiffusionAgent(*cogServer);

        atq = new AttentionParamQuery(as);
        atq->load_default_values();

        AbstractFactory<Agent>* afImportanceDiffusionAgentFactory = new Factory<AFImportanceDiffusionAgent, Agent>();
        scheduler->registerAgent(AFImportanceDiffusionAgent::info().id, afImportanceDiffusionAgentFactory);

        std::cout << "Setup completed for AFImportanceDiffusionAgentLargeUTest." << std::endl;
    }

    void tearDown()
    {
        delete afImportanceDiffusionAgent;
        delete atq;
        cogServer->stop();
        std::cout << "TearDown completed for AFImportanceDiffusionAgentLargeUTest." << std::endl;
    }

    void testLargeDiffusion()
    {
        // Add 1000 nodes and links for benchmarking
        int targetNodeCount = 1000;
        std::vector<std::string> baseNames;
        std::ifstream nameFile("tests/attention/meaningful_names.txt");
        if (!nameFile.is_open()) {
            nameFile.open("../tests/attention/meaningful_names.txt");
        }
        if (!nameFile.is_open()) {
            nameFile.open("meaningful_names.txt"); 
        }
        
        std::string line;
        while (std::getline(nameFile, line)) {
            if (!line.empty()) {
                baseNames.push_back(line);
            }
        }
        
        if (baseNames.empty()) {
            baseNames.push_back("Node");
        }

        std::vector<Handle> nodes;
        AttentionBank& ab = attentionbank(as);
        ab.set_af_size(100); // Ensure all nodes can fit in AF

        for (int i = 0; i < targetNodeCount; ++i) {
            std::string name = baseNames[i % baseNames.size()] + "_" + std::to_string(i);
            Handle node = as->add_node(CONCEPT_NODE, std::string(name));
            nodes.push_back(node);
            ab.stimulate(node, 30); 
        }

        // Add more complex linking: each node links to its next 3 neighbors
        std::vector<Handle> monitoredLinks;
        for (size_t i = 0; i < nodes.size(); ++i) {
            for (size_t j = 1; j <= 3 && (i + j) < nodes.size(); ++j) {
                Handle link = as->add_link(INHERITANCE_LINK, nodes[i], nodes[i+j]);
                // Monitor links originating from the first node and a middle node
                if (i == 0 || i == 500) {
                    monitoredLinks.push_back(link);
                }
            }
        }

        std::cout << "Benchmark Setup: " << nodes.size() << " nodes and complex interconnected links." << std::endl;

        // Capture state before diffusion
        std::cout << "\nInitial STI check:" << std::endl;
        std::cout << "Node[0] STI: " << get_sti(nodes[0]) << std::endl;
        for (auto& l : monitoredLinks) {
            std::cout << "Link " << l->to_string() << " STI: " << get_sti(l) << std::endl;
        }

        // Warm up
        afImportanceDiffusionAgent->run();

        // Benchmark
        int cycles = 50;
        std::cout << "\nStarting benchmark of " << cycles << " diffusion cycles..." << std::endl;
        
        auto start = std::chrono::high_resolution_clock::now();
        for (int i = 0; i < cycles; ++i) {
            afImportanceDiffusionAgent->run();
        }
        auto end = std::chrono::high_resolution_clock::now();

        std::chrono::duration<double> diff = end - start;
        
        std::cout << "\n--- DIFFUSION BENCHMARK RESULTS ---" << std::endl;
        std::cout << "Nodes in network:    " << targetNodeCount << std::endl;
        std::cout << "Total time:          " << diff.count() << " s" << std::endl;
        std::cout << "Avg time per cycle:  " << (diff.count() / cycles) * 1000.0 << " ms" << std::endl;
        std::cout << "-----------------------------------\n" << std::endl;

        // Verify Diffusion
        std::cout << "Final STI check (Verifying spread):" << std::endl;
        std::cout << "Node[0] STI: " << get_sti(nodes[0]) << " (Should be lower due to giving away STI)" << std::endl;
        for (auto& l : monitoredLinks) {
            std::cout << "Link " << l->to_string() << " STI: " << get_sti(l) << " (Should be > 0 if diffusion worked)" << std::endl;
        }

        double totalSTIAfter = 0;
        for (const auto& h : nodes) totalSTIAfter += get_sti(h);
        
        TS_ASSERT(totalSTIAfter > 0);
    }
};
